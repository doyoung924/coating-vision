# Oracle DB 접속 (§3단계 3-1)
# 이 파일을 복사해 .env 로 저장 후 값을 채운다. .env 는 커밋 금지.
#
# ORACLE_HOST: WSL 호스트 IP. 재부팅 시 바뀌므로 비워두면 앱이
#   `ip route show | grep default` 로 자동 감지한다. 고정 IP 를
#   쓰거나 tunnel 이 있으면 직접 지정.

ORACLE_HOST=
ORACLE_USER=scott
# 로컬 개발 시 Oracle 튜토리얼 관례값 (tiger) 을 그대로 써도 되나,
# 실제 배포 시에는 반드시 강한 값으로 변경할 것.
ORACLE_PASSWORD=change-me-password
ORACLE_PORT=1521
ORACLE_SERVICE=XE
ORACLE_CLIENT_LIB=/home/doyoung/oracle/instantclient_19_32

# Flask 세션 서명 키
SECRET_KEY=change-me-in-production

# 초기 admin 계정 비밀번호. sql/init_db.py 가 이 값을 해싱해 저장한다.
# 미설정 시 랜덤값이 생성되어 stdout 에 출력된다.
ADMIN_PASSWORD=change-me-strong-password

# §3-8 업로드 파일 정리 정책
UPLOAD_RETENTION_DAYS=30
LOG_LEVEL=INFO
